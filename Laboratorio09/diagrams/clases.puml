@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package Modelo {
  abstract class Actividad {
    - id : string
    - titulo : string
    - fecha : string
    - detalle : string
    + registro() : RegistroActividad
    + tipo() : string
  }
  class Tarea
  class Examen
  class Proyecto
  interface IRepositorioActividades {
    + guardar(actividad)
    + listar() : vector<RegistroActividad>
  }
  interface IImportadorActividades {
    + importar() : size_t
  }
  class RepositorioCsv
}

package Vista {
  class VistaConsola {
    + ejecutar()
    - crearActividad()
    - listarActividades()
    - importarCsvAntiguo()
  }
}

package Controlador {
  class ActividadController {
    + crear(tipo, datos)
    + listar()
    + importarCsvAntiguo()
  }
}

package "Factory Method" {
  abstract class ActividadCreator {
    + crear(datos) : Actividad
  }
  class TareaCreator
  class ExamenCreator
  class ProyectoCreator
  class ActividadFactory {
    + registrar(tipo, creator)
    + crear(tipo, datos) : Actividad
  }
}

package "Adapter CSV" {
  class FuenteCsvAntigua {
    + leer() : vector<RegistroCsvAntiguo>
  }
  class AdaptadorCsvAntiguo {
    + importar() : size_t
    + guardar(actividad)
    + listar() : vector<RegistroActividad>
  }
}

Actividad <|-- Tarea
Actividad <|-- Examen
Actividad <|-- Proyecto
IRepositorioActividades <|.. RepositorioCsv
IRepositorioActividades <|.. AdaptadorCsvAntiguo
IImportadorActividades <|.. AdaptadorCsvAntiguo
ActividadCreator <|-- TareaCreator
ActividadCreator <|-- ExamenCreator
ActividadCreator <|-- ProyectoCreator
VistaConsola --> ActividadController
ActividadController --> ActividadFactory
ActividadController --> IRepositorioActividades
ActividadController --> IImportadorActividades
ActividadFactory o--> ActividadCreator
ActividadCreator ..> Actividad : crea
AdaptadorCsvAntiguo --> FuenteCsvAntigua
AdaptadorCsvAntiguo --> IRepositorioActividades : delega
AdaptadorCsvAntiguo --> ActividadFactory : normaliza tipo
RepositorioCsv ..> RegistroActividad
@enduml
