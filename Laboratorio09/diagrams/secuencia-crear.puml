@startuml
actor Usuario
participant VistaConsola as Vista
participant ActividadController as Controlador
participant ActividadFactory as Fabrica
participant ActividadCreator as Creador
participant IRepositorioActividades as Repositorio

Usuario -> Vista : selecciona Crear y completa datos
Vista -> Controlador : crear(tipo, datos)
Controlador -> Fabrica : crear(tipo, datos)
Fabrica -> Creador : crear(datos)
Creador --> Fabrica : Actividad concreta
Fabrica --> Controlador : Actividad
Controlador -> Repositorio : guardar(actividad.registro())
Repositorio --> Controlador : confirmación
Controlador --> Vista : mensaje de creación
Vista --> Usuario : muestra resultado
@enduml
