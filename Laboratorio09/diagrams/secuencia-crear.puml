@startuml
actor Usuario
participant VistaConsola as Vista
participant ActividadController as Controlador
participant CreadorTarea as Creador
participant Actividad as Producto
participant IRepositorioActividades as Repositorio

Usuario -> Vista : ingresa tipo y datos
Vista -> Controlador : crear(tipo, datos)
Controlador -> Creador : crear(datos)
Creador -> Creador : factoryMethod(datos)
Creador --> Controlador : Tarea
Controlador -> Repositorio : guardar(Tarea)
Controlador --> Vista : confirmación
Vista --> Usuario : muestra resultado
@enduml
