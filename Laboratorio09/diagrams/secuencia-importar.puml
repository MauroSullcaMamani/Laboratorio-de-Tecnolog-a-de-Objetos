@startuml
actor Usuario
participant VistaConsola as Vista
participant ActividadController as Controlador
participant AdaptadorImportacionCsv as Adapter
participant LectorCsvImportacion as Lector
participant CreadorActividad as Creador
participant IRepositorioActividades as Repositorio

Usuario -> Vista : solicita importar CSV
Vista -> Controlador : importarCsv()
Controlador -> Adapter : importar()
Adapter -> Lector : leer()
Lector --> Adapter : filas de origen
loop por cada fila
  Adapter -> Creador : crear(datos convertidos)
  Creador --> Adapter : Actividad
  Adapter -> Repositorio : guardar(actividad)
end
Adapter --> Controlador : cantidad importada
Controlador --> Vista : cantidad importada
Vista --> Usuario : muestra resumen
@enduml
