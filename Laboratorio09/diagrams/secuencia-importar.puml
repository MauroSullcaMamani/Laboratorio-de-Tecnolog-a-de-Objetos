@startuml
actor Usuario
participant VistaConsola as Vista
participant ActividadController as Controlador
participant AdaptadorCsvAntiguo as Adapter
participant FuenteCsvAntigua as Fuente
participant ActividadFactory as Fabrica
participant IRepositorioActividades as Repositorio

Usuario -> Vista : selecciona Importar CSV
Vista -> Controlador : importarCsvAntiguo()
Controlador -> Adapter : importar()
Adapter -> Fuente : leer()
Fuente --> Adapter : filas heredadas
loop por fila
  Adapter -> Fabrica : crear(tipo normalizado, datos)
  Fabrica --> Adapter : Actividad
  Adapter -> Repositorio : guardar(actividad.registro())
end
Adapter --> Controlador : cantidad importada
Controlador --> Vista : cantidad importada
Vista --> Usuario : muestra resumen
@enduml
